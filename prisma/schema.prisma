generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String              @id @default(uuid())
  name          String
  slug          String              @unique
  status        TenantStatus        @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  logoUrl       String?
  primaryColor  String              @default("#22d3ee")
  supportEmail  String?
  settings      Json                @default("{}")
  paymentEvents PaymentEvent[]
  stores        Store[]
  subscription  TenantSubscription?
  users         User[]

  @@index([status])
}

model User {
  tenantId  String
  id        String   @id @default(uuid())
  name      String
  email     String
  password  String
  createdAt DateTime @default(now())
  role      UserRole @default(MEMBER)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Store {
  tenantId  String
  id        String    @id @default(uuid())
  name      String
  location  String?
  createdAt DateTime  @default(now())
  products  Product[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, name])
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String
  price     Float
  quantity  Int
  minStock  Int
  category  String
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, storeId])
  @@index([tenantId, category])
}

model TenantSubscription {
  id                     String             @id @default(uuid())
  tenantId               String             @unique
  status                 SubscriptionStatus @default(TRIAL)
  provider               PaymentProvider?
  providerCustomerId     String?
  providerSubscriptionId String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  blockedAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt
  planId                 String
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id])
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([tenantId, status])
  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEnd])
  @@index([provider, providerCustomerId])
  @@index([provider, providerSubscriptionId])
}

model SubscriptionPlan {
  id                String               @id @default(uuid())
  slug              String               @unique
  name              String
  description       String?
  priceCents        Int                  @default(0)
  currency          String               @default("BRL")
  trialDays         Int                  @default(14)
  productLimit      Int?
  storeLimit        Int?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
  code              PlanCode             @unique
  stripePriceId     String?
  mercadoPagoPlanId String?
  subscriptions     TenantSubscription[]

  @@index([isActive])
  @@index([stripePriceId])
  @@index([mercadoPagoPlanId])
}

model PaymentEvent {
  id              String          @id @default(uuid())
  tenantId        String
  provider        PaymentProvider
  providerEventId String
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime        @default(now())
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([tenantId])
  @@index([tenantId, provider, eventType])
  @@index([provider, eventType])
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  ADMIN
  MEMBER
}

enum PlanCode {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  BLOCKED
  CANCELED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
}
