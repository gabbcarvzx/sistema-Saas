# Banco
# Runtime serverless/Vercel: Supabase Supavisor Transaction pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Prisma CLI, migrations, db pull, seed e Studio: Supabase Supavisor Session pooler.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Pool pequeno por instancia serverless. Ajuste conforme plano/concurrency.
PGPOOL_MAX="3"
PGCONNECT_TIMEOUT_MS="10000"
PGIDLE_TIMEOUT_MS="30000"

# Aplicacao / tenancy
APP_ROOT_DOMAIN="seudominio.com"
APP_URL="https://app.seudominio.com"
DEFAULT_TENANT_SLUG="demo-oficina"
DEFAULT_TENANT_NAME="Oficina Demo"
DEFAULT_TRIAL_DAYS="14"
SUPPORT_EMAIL="suporte@seudominio.com"

# Seguranca
INTERNAL_ACCESS_SECRET="gere-um-segredo-com-32-caracteres-ou-mais"
CRON_SECRET="gere-um-segredo-para-o-vercel-cron"
JWT_SECRET="gere-outro-segredo-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="stockpro"
JWT_AUDIENCE="stockpro-app"
PASSWORD_HASH_COST="12"

